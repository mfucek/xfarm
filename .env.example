# Vertex AI Gemini credentials. xfarm reads these at runtime (Bun loads .env automatically).
# When set, these override the corresponding fields in ~/.xfarm/config.yaml.
#
# GOOGLE_VERTEX_CREDENTIALS_B64
#   Base64-encoded service-account JSON key. xfarm decodes this on each daemon
#   start and writes it to ~/.xfarm/.cache/vertex-sa.json (chmod 600), then
#   points GOOGLE_APPLICATION_CREDENTIALS at that file.
#   To produce: base64 < your-sa-key.json | tr -d '\n'

GOOGLE_VERTEX_CREDENTIALS_B64=
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=us-central1

# Unused by xfarm (embeddings aren't needed for the judge), but harmless to keep.
GOOGLE_VERTEX_EMBEDDING_LOCATION=us-central1

# Naumu MCP — primary configuration lives under judge.naumu in config.yaml
# (editable from the TUI). These env vars override the YAML values when set,
# which is useful for keeping the API key out of the YAML on shared machines.
# Leave blank to use whatever config.yaml has.
NAUMU_API_KEY=
NAUMU_GRAPH_ID=
